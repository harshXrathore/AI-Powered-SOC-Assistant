# ==============================================================================
# AI SOC Assistant — Root Environment Template
# Copy this to .env and to backend/.env, fill in real values.
# NEVER commit real secrets. This file only documents shape/expected keys.
# ==============================================================================

# --- Postgres ---
POSTGRES_USER=soc_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=soc_assistant
DATABASE_URL=postgresql+asyncpg://soc_admin:changeme@postgres:5432/soc_assistant
# Sync URL used only by Alembic migrations (asyncpg has no sync driver).
DATABASE_URL_SYNC=postgresql+psycopg2://soc_admin:changeme@postgres:5432/soc_assistant

# --- Redis / Celery ---
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@redis:6379/0
CELERY_BROKER_URL=redis://:changeme@redis:6379/1
CELERY_RESULT_BACKEND=redis://:changeme@redis:6379/2

# --- Auth ---
JWT_SECRET_KEY=replace_with_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Wazuh (external SIEM this app connects to) ---
WAZUH_API_URL=https://your-wazuh-manager:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=changeme
WAZUH_VERIFY_SSL=false
WAZUH_INDEXER_URL=https://your-wazuh-indexer:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=changeme
WAZUH_SYNC_INTERVAL_SECONDS=60
WAZUH_SYNC_LOOKBACK_MINUTES=5

# --- Threat Intelligence APIs ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_OTX_API_KEY=

# --- AI Provider ---
AI_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- App ---
ENVIRONMENT=development        # development | staging | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
